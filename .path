#!/bin/sh

# go path
export GOPATH="${HOME}/.go"

# update path
export PATH=/usr/local/bin:/usr/local/sbin:${PATH}:/sbin

# add go path
export PATH="/usr/local/go/bin:${GOPATH}/bin:${PATH}"

# add rust path
export PATH="${HOME}/.cargo/bin:${PATH}"

# add bcc tools path
export PATH="/usr/share/bcc/tools:${PATH}"

# update cdpath
export CDPATH=${CDPATH}:${GOPATH}/src/github.com:${GOPATH}/src/golang.org:${GOPATH}/src

# The next line updates PATH for the Google Cloud SDK.
# shellcheck source=/dev/null
if [ -f "${HOME}/google-cloud-sdk/path.bash.inc" ]; then . "${HOME}/google-cloud-sdk/path.bash.inc"; fi

# The next line enables shell command completion for gcloud.
# shellcheck source=/dev/null
if [ -f "${HOME}/google-cloud-sdk/completion.bash.inc" ]; then . "${HOME}/google-cloud-sdk/completion.bash.inc"; fi

# update path for gnu coreutils, make & find on darwin; Homebrew lives in
# /opt/homebrew on Apple Silicon and /usr/local on Intel
if [ "$(uname -s)" = Darwin ]; then
	for brew_prefix in /opt/homebrew /usr/local; do
		if [ -d "${brew_prefix}/opt" ]; then
			for tool in coreutils make findutils; do
				export PATH="${brew_prefix}/opt/${tool}/libexec/gnubin:${PATH}"
				export MANPATH="${brew_prefix}/opt/${tool}/libexec/gnuman:${MANPATH}"
			done
			break
		fi
	done
	unset brew_prefix tool
fi

# update path for Chromium depot_tools
export PATH="${PATH}:${HOME}/depot_tools"

# Add bash completion for Chromium depot_tools
# shellcheck source=/dev/null
if [ -f "${HOME}/depot_tools/git_cl_completion.sh" ]; then . "${HOME}/depot_tools/git_cl_completion.sh"; fi
