#!/bin/bash

# Make vim the default editor
# export EDITOR=/usr/bin/nvim;
export EDITOR=/usr/bin/nano;

# Larger bash history (allow 32³ entries; default is 500)
export HISTSIZE=50000000;
export HISTFILESIZE=$HISTSIZE;
export HISTCONTROL=ignoredups;
# Make some commands not show up in history
export HISTIGNORE=" *:ls:cd:cd -:pwd:exit:date:* --help:* -h:pony:pony add *:pony update *:pony save *:pony ls:pony ls *";

# Prefer US English and use UTF-8, falling back to C.UTF-8 where en_US is
# not generated, as on minimal Debian and Ubuntu images
if locale -a 2>/dev/null | grep -qiE '^en_US\.utf-?8$'; then
	export LANG="en_US.UTF-8";
	export LC_ALL="en_US.UTF-8";
else
	export LANG="C.UTF-8";
	export LC_ALL="C.UTF-8";
fi

# Don’t clear the screen after quitting a manual page
export MANPAGER="less -X";

export TODOTXT_DEFAULT_ACTION=ls

# Linux desktop session only: not on macOS, not over a plain SSH login
if [[ "$(uname -s)" == Linux ]] && [[ -n "${DISPLAY}${WAYLAND_DISPLAY}" ]]; then
	export TERMINAL="urxvt";

	export DBUS_SESSION_BUS_ADDRESS
	DBUS_SESSION_BUS_ADDRESS=unix:path=/var/run/user/$(id -u)/bus;

	# hidpi for gtk apps
	export GDK_SCALE=2
	export GDK_DPI_SCALE=0.5
	export QT_DEVICE_PIXEL_RATIO=2
fi

# turn on go vendoring experiment
export GO15VENDOREXPERIMENT=1

#  Consider enabling DOCKER_CONTENT_TRUST
#  https://docs.docker.com/v17.09/engine/security/trust/content_trust/
#export DOCKER_CONTENT_TRUST=1

# if it's an ssh session export GPG_TTY
if [[ -n "$SSH_CLIENT" ]] || [[ -n "$SSH_TTY" ]]; then
	GPG_TTY=$(tty)
	export GPG_TTY
fi
