#!/usr/bin/env python3
"""Resolve private Google identities before installing the Nix config."""

import argparse
import json
import os
import stat
import subprocess
import sys
import tempfile
import tomllib
from pathlib import Path


class ConfigError(Exception):
    """A diagnostic that never includes a private account value."""


def accounts(path: Path) -> dict[str, str]:
    try:
        descriptor = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
    except FileNotFoundError:
        raise ConfigError("Missing private accounts.toml; provision the Google account bindings before activation.") from None
    with os.fdopen(descriptor, "rb") as stream:
        info = os.fstat(stream.fileno())
        if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid() or stat.S_IMODE(info.st_mode) & 0o077:
            raise ConfigError("Private accounts.toml must be an owner-only regular file.")
        try:
            data = tomllib.load(stream)
        except tomllib.TOMLDecodeError:
            raise ConfigError("Private accounts.toml is not valid TOML.") from None
    google = data.get("google")
    if set(data) != {"google"} or not isinstance(google, dict) or set(google) != {"personal", "work"}:
        raise ConfigError("Private accounts.toml needs [google] personal and work bindings.")
    result: dict[str, str] = {}
    for role in ("personal", "work"):
        value = google[role]
        if not isinstance(value, str) or value.count("@") != 1 or any(character.isspace() or ord(character) < 32 for character in value) or not all(value.split("@")):
            raise ConfigError(f"The private Google {role} binding must be an email identity.")
        result[role] = value
    if result["personal"].casefold() == result["work"].casefold():
        raise ConfigError("The private Google account bindings must identify distinct accounts.")
    return result


def render(template: Path, bindings: Path) -> str:
    values = accounts(bindings)
    contents = template.read_text()
    for role, value in values.items():
        marker = json.dumps(f"@google.{role}@")
        if contents.count(marker) != 2:
            raise ConfigError("The Nix template must bind both Google auth and namespace identities.")
        contents = contents.replace(marker, json.dumps(value))
    try:
        tomllib.loads(contents)
    except tomllib.TOMLDecodeError:
        raise ConfigError("The rendered Switchboard configuration is not valid TOML.") from None
    return contents


def install(template: Path, bindings: Path, destination: Path, switchboard: str) -> None:
    contents = render(template, bindings)
    try:
        before = destination.lstat()
    except FileNotFoundError:
        before = None
    if before is not None and (not stat.S_ISREG(before.st_mode) or before.st_uid != os.getuid()):
        raise ConfigError("The existing Switchboard configuration must be an owned regular file.")
    original = destination.read_bytes() if before is not None else None
    temporary: Path | None = None
    try:
        with tempfile.NamedTemporaryFile(mode="w", encoding="utf-8", dir=destination.parent, prefix=".switchboard-", suffix=".toml", delete=False) as stream:
            temporary = Path(stream.name)
            os.fchmod(stream.fileno(), 0o600)
            stream.write(contents)
            stream.flush()
            os.fsync(stream.fileno())
        try:
            checked = subprocess.run(
                [switchboard, "--config", str(temporary), "tools", "list", "--ns", "google.personal", "--limit", "1", "--json"],
                stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                timeout=30, check=False,
            )
        except (OSError, subprocess.TimeoutExpired):
            raise ConfigError("Switchboard validation could not run; the current configuration was retained.") from None
        if checked.returncode != 0:
            raise ConfigError("Switchboard rejected the candidate; the current configuration was retained.")
        current = destination.read_bytes() if destination.exists() else None
        if current != original:
            raise ConfigError("Switchboard configuration changed during activation; the current file was retained.")
        os.replace(temporary, destination)
        temporary = None
        descriptor = os.open(destination.parent, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(descriptor)
        finally:
            os.close(descriptor)
    finally:
        if temporary is not None:
            temporary.unlink(missing_ok=True)


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--template", required=True, type=Path)
    parser.add_argument("--accounts", required=True, type=Path)
    parser.add_argument("--destination", required=True, type=Path)
    parser.add_argument("--switchboard", default="switchboard")
    arguments = parser.parse_args()
    try:
        install(arguments.template, arguments.accounts, arguments.destination, arguments.switchboard)
    except ConfigError as error:
        print(f"switchboard-config: {error}", file=sys.stderr)
        return 1
    except OSError:
        print("switchboard-config: private configuration could not be prepared; existing configuration was retained.", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
